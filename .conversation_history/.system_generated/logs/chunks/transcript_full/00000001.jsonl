{"step_index":93,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-15T08:35:34Z","content":"Created At: 2026-09-15T14:05:34+05:30\nCompleted At: 2026-09-15T14:05:35+05:30\nFile Path: `file:///c:/Abhi/AntiGravity/DhanvantariSuite-Phase1-Professional-OPD-v11/DhanvantariSuite-Phase1-Professional-OPD-v11/src/adapters/api/dependencies.py`\nTotal Lines: 145\nTotal Bytes: 5955\nShowing lines 1 to 145\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: from typing import Generator, Tuple, Optional\n2: from datetime import datetime\n3: from fastapi import Depends, HTTPException, status, Header\n4: from fastapi.security import OAuth2PasswordBearer\n5: from jose import jwt, JWTError\n6: from sqlalchemy.orm import Session\n7: \n8: from src.adapters.db.connection import get_db_session\n9: from src.services.auth_service import SECRET_KEY, ALGORITHM\n10: from src.domain.models.user import UserRole, User\n11: \n12: oauth2_scheme = OAuth2PasswordBearer(tokenUrl=\"/api/auth/login\", auto_error=True)\n13: \n14: def get_db() -> Generator[Session, None, None]:\n15:     with get_db_session() as session:\n16:         yield session\n17: \n18: def get_tenant_context(\n19:     x_tenant_id: Optional[str] = Header(None, alias=\"X-Tenant-ID\"),\n20:     x_branch_id: Optional[str] = Header(None, alias=\"X-Branch-ID\"),\n21:     authorization: Optional[str] = Header(None)\n22: ) -> Tuple[str, str]:\n23:     \"\"\"\n24:     Resolves the tenant_id and branch_id for the request.\n25:     In local single-tenant desktop mode: defaults to 'local-clinic' and 'branch-main'.\n26:     In cloud SaaS mode: reads headers or parses JWT.\n27:     \"\"\"\n28:     tenant_id = x_tenant_id or \"local-clinic\"\n29:     branch_id = x_branch_id or \"branch-main\"\n30: \n31:     # If JWT is provided, extract tenant info from it\n32:     if authorization and authorization.startswith(\"Bearer \"):\n33:         token = authorization.split(\" \")[1]\n34:         try:\n35:             payload = jwt.decode(token, SECRET_KEY, algorithms=[ALGORITHM])\n36:             tenant_id = payload.get(\"tenant_id\", tenant_id)\n37:             branch_id = payload.get(\"branch_id\", branch_id)\n38:         except JWTError:\n39:             pass # Fallback to header or default in case of invalid token during local debug\n40: \n41:     return tenant_id, branch_id\n42: \n43: def get_current_user_claims(\n44:     token: str = Depends(oauth2_scheme),\n45:     context: Tuple[str, str] = Depends(get_tenant_context)\n46: ) -> dict:\n47:     \"\"\"Require a valid JWT for every protected API request.\"\"\"\n48:     tenant_id, branch_id = context\n49:     try:\n50:         payload = jwt.decode(token, SECRET_KEY, algorithms=[ALGORITHM])\n51:         user_id: str = payload.get(\"sub\")\n52:         username: str = payload.get(\"username\")\n53:         role: str = payload.get(\"role\")\n54:         token_tenant: str = payload.get(\"tenant_id\")\n55:         token_branch: str = payload.get(\"branch_id\")\n56:         if not user_id or not username or not role:\n57:             raise HTTPException(status_code=status.HTTP_401_UNAUTHORIZED, detail=\"Could not validate credentials\", headers={\"WWW-Authenticate\": \"Bearer\"})\n58:         return {\"user_id\": user_id, \"username\": username, \"role\": role, \"tenant_id\": token_tenant or tenant_id, \"branch_id\": token_branch or branch_id}\n59:     except JWTError:\n60:         raise HTTPException(status_code=status.HTTP_401_UNAUTHORIZED, detail=\"Could not validate credentials\", headers={\"WWW-Authenticate\": \"Bearer\"})\n61: \n62: def require_role(allowed_roles: list[UserRole]):\n63:     def role_dependency(user: User = Depends(get_current_user)):\n64:         if user.role not in allowed_roles:\n65:             raise HTTPException(\n66:                 status_code=status.HTTP_403_FORBIDDEN,\n67:                 detail=\"You do not have permission to access this resource\"\n68:             )\n69:         return user\n70:     return role_dependency\n71: \n72: def get_current_user(\n73:     db: Session = Depends(get_db),\n74:     claims: dict = Depends(get_current_user_claims)\n75: ) -> User:\n76:     tenant_id = claims[\"tenant_id\"]\n77:     user_id = claims[\"user_id\"]\n78:     if user_id == \"local-admin-id\":\n79:         return User(\n80:             id=\"local-admin-id\",\n81:             tenant_id=tenant_id,\n82:             branch_id=claims[\"branch_id\"],\n83:             username=\"local-admin\",\n84:             password_hash=\"\",\n85:             full_name=\"Local Administrator\",\n86:             role=UserRole.ADMIN,\n87:             can_collect_payment=True,\n88:             can_enter_vitals=True,\n89:             can_view_clinical_history=True,\n90:             can_edit_clinical_data=True,\n91:             status=\"Active\",\n92:             created_at=datetime.utcnow(),\n93:             updated_at=datetime.utcnow()\n94:         )\n95:     from src.adapters.db.repositories import SQLAlchemyUserRepository\n96:     user_repo = SQLAlchemyUserRepository(db)\n97:     user = user_repo.find_by_id(user_id, tenant_id)\n98:     if not user:\n99:         raise HTTPException(\n100:             status_code=status.HTTP_401_UNAUTHORIZED,\n101:             detail=\"User not found\",\n102:             headers={\"WWW-Authenticate\": \"Bearer\"},\n103:         )\n104:     if user.status != \"Active\":\n105:         raise HTTPException(\n106:             status_code=status.HTTP_403_FORBIDDEN,\n107:             detail=\"User is deactivated\"\n108:         )\n109:     return user\n110: \n111: def require_payment_collection():\n112:     def dep(user: User = Depends(get_current_user)):\n113:         if user.role == UserRole.ADMIN:\n114:             return user\n115:         if not user.can_collect_payment:\n116:             raise HTTPException(status_code=status.HTTP_403_FORBIDDEN, detail=\"You do not have permission to collect payments\")\n117:         return user\n118:     return dep\n119: \n120: def require_vitals_recording():\n121:     def dep(user: User = Depends(get_current_user)):\n122:         if user.role == UserRole.ADMIN:\n123:             return user\n124:         if not user.can_enter_vitals:\n125:             raise HTTPException(status_code=status.HTTP_403_FORBIDDEN, detail=\"You do not have permission to enter vitals\")\n126:         return user\n127:     return dep\n128: \n129: def require_clinical_view():\n130:     def dep(user: User = Depends(get_current_user)):\n131:         if user.role in [UserRole.ADMIN, UserRole.DOCTOR]:\n132:             return user\n133:         if not user.can_view_clinical_history:\n134:             raise HTTPException(status_code=status.HTTP_403_FORBIDDEN, detail=\"You do not have permission to view clinical history\")\n135:         return user\n136:     return dep\n137: \n138: def require_clinical_edit():\n139:     def dep(user: User = Depends(get_current_user)):\n140:         # Phase 1: only doctors can create/update clinical consultation data.\n141:         if user.role == UserRole.DOCTOR and user.can_edit_clinical_data:\n142:             return user\n143:         raise HTTPException(status_code=status.HTTP_403_FORBIDDEN, detail=\"Only an authorized Doctor can edit clinical consultation data\")\n144:     return dep\n145: \nThe above content shows the entire, complete file contents of the requested file.\n"}
