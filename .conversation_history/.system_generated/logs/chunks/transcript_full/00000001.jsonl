=Appointment)\n68: def check_in(appointment_id: str, db: Session = Depends(get_db), current_user: User = Depends(require_role([UserRole.ADMIN, UserRole.RECEPTIONIST]))):\n69:     appt = SQLAlchemyAppointmentRepository(db).find_by_id(appointment_id, current_user.tenant_id)\n70:     if not appt:\n71:         raise HTTPException(status_code=404, detail=\"Appointment not found\")\n72:     if appt.status in [AppointmentStatus.IN_QUEUE, AppointmentStatus.CHECKED_IN]:\n73:         return appt\n74:     if appt.status not in [AppointmentStatus.SCHEDULED, AppointmentStatus.BOOKED]:\n75:         raise HTTPException(status_code=400, detail=f\"Cannot check in appointment with status {appt.status.value}\")\n76:     doctors = active_doctors(db, current_user)\n77:     if len(doctors) == 1:\n78:         appt.status = AppointmentStatus.CHECKED_IN\n79:         appt.updated_at = datetime.utcnow()\n80:         return SQLAlchemyAppointmentRepository(db).save(appt)\n81:     return QueueService(SQLAlchemyAppointmentRepository(db)).check_in_patient(appointment_id, current_user.tenant_id)\n82: \n83: \n84: @router.post(\"/{appointment_id}/start-consult\", response_model=Appointment)\n85: def start_consult(appointment_id: str, db: Session = Depends(get_db), current_user: User = Depends(require_role([UserRole.DOCTOR]))):\n86:     repo = SQLAlchemyAppointmentRepository(db)\n87:     appt = repo.find_by_id(appointment_id, current_user.tenant_id)\n88:     if not appt:\n89:         raise HTTPException(status_code=404, detail=\"Appointment not found\")\n90:     if current_user.role == UserRole.DOCTOR and appt.doctor_id != current_user.id:\n91:         raise HTTPException(status_code=403, detail=\"This patient is assigned to another doctor.\")\n92:     if appt.status == AppointmentStatus.CONSULTING:\n93:         return appt\n94:     doctors = active_doctors(db, current_user)\n95:     if len(doctors) == 1 and appt.status in [AppointmentStatus.BOOKED, AppointmentStatus.CHECKED_IN]:\n96:         appt.status = AppointmentStatus.CONSULTING\n97:         repo.save(appt)\n98:         return appt\n99:     if appt.status != AppointmentStatus.IN_QUEUE:\n100:         raise HTTPException(status_code=400, detail=\"Patient must be checked in before consultation starts.\")\n101:     return QueueService(repo).start_consultation(appointment_id, current_user.tenant_id)\n102: \n103: \n104: @router.get(\"/live\", response_model=List[Appointment])\n105: def get_live_queue(query_date: Optional[date] = None, db: Session = Depends(get_db), current_user: User = Depends(get_current_user)):\n106:     queue = QueueService(SQLAlchemyAppointmentRepository(db)).get_live_queue(current_user.tenant_id, current_user.branch_id, query_date)\n107:     if current_user.role == UserRole.DOCTOR:\n108:         queue = [a for a in queue if a.doctor_id == current_user.id]\n109:     return queue\n110: \n111: \n112: @router.get(\"/live/details\")\n113: def get_live_queue_details(query_date: Optional[date] = None, db: Session = Depends(get_db), current_user: User = Depends(get_current_user)):\n114:     queue = QueueService(SQLAlchemyAppointmentRepository(db)).get_live_queue(current_user.tenant_id, current_user.branch_id, query_date)\n115:     if current_user.role == UserRole.DOCTOR:\n116:         queue = [a for a in queue if a.doctor_id == current_user.id]\n117:     patient_repo = SQLAlchemyPatientRepository(db)\n118:     user_repo = SQLAlchemyUserRepository(db)\n119:     result = []\n120:     for a in queue:\n121:         p = patient_repo.find_by_id(a.patient_id, current_user.tenant_id)\n122:         d = user_repo.find_by_id(a.doctor_id, current_user.tenant_id)\n123:         result.append({\"appointment\": a, \"patient\": p, \"doctor_name\": d.full_name if d else \"\"})\n124:     return result\n125: \nThe above content shows the entire, complete file contents of the requested file.\n"}
