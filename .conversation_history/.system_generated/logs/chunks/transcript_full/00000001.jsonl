n72:         return self.appointment_repo.save(appointment)\n73: \n74:     def get_live_queue(self, tenant_id: str, branch_id: str, query_date: Optional[date] = None) -> List[Appointment]:\n75:         if not query_date:\n76:             query_date = date.today()\n77:         return self.appointment_repo.list_queue(query_date, tenant_id, branch_id)\n78: \nThe above content shows the entire, complete file contents of the requested file.\n"}
