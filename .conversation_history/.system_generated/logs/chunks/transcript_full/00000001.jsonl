:     spo2: Optional[int] = None\n31:     respiratory_rate: Optional[int] = None\n32:     follow_up_date: Optional[date] = None\n33:     notes: Optional[str] = \"\"\n34:     consultation_type: Optional[str] = None\n35:     consultation_subtype: Optional[str] = None\n36: \n37: @router.post(\"/complete\", response_model=Consultation)\n38: def complete_consultation(\n39:     req: ConsultationCompleteRequest,\n40:     db: Session = Depends(get_db),\n41:     current_user: User = Depends(require_clinical_edit())\n42: ):\n43:     tenant_id = current_user.tenant_id\n44:     branch_id = current_user.branch_id\n45:     \n46:     consultation_repo = SQLAlchemyConsultationRepository(db)\n47:     appointment_repo = SQLAlchemyAppointmentRepository(db)\n48:     vitals_repo = SQLAlchemyVitalsRepository(db)\n49:     consultation_service = ConsultationService(consultation_repo, appointment_repo, vitals_repo)\n50:     \n51:     try:\n52:         return consultation_service.complete_consultation(\n53:             tenant_id=tenant_id,\n54:             branch_id=branch_id,\n55:             appointment_id=req.appointment_id,\n56:             symptoms=req.symptoms,\n57:             diagnosis=req.diagnosis,\n58:             prescription=req.prescription,\n59:             blood_pressure=req.blood_pressure,\n60:             weight=req.weight,\n61:             height=req.height,\n62:             bmi=req.bmi,\n63:             temperature=req.temperature,\n64:             pulse_rate=req.pulse_rate,\n65:             spo2=req.spo2,\n66:             respiratory_rate=req.respiratory_rate,\n67:             follow_up_date=req.follow_up_date,\n68:             notes=req.notes,\n69:             consultation_type=req.consultation_type,\n70:             consultation_subtype=req.consultation_subtype\n71:         )\n72:     except ValueError as e:\n73:         raise HTTPException(status_code=status.HTTP_400_BAD_REQUEST, detail=str(e))\n74: \n75: @router.get(\"/patient/{patient_id}/history\", response_model=List[Consultation])\n76: def get_patient_history(\n77:     patient_id: str,\n78:     db: Session = Depends(get_db),\n79:     current_user: User = Depends(require_clinical_view())\n80: ):\n81:     tenant_id = current_user.tenant_id\n82:     consultation_repo = SQLAlchemyConsultationRepository(db)\n83:     appointment_repo = SQLAlchemyAppointmentRepository(db)\n84:     consultation_service = ConsultationService(consultation_repo, appointment_repo)\n85:     return consultation_service.get_patient_history(patient_id, tenant_id)\n86: \n87: @router.get(\"/{consultation_id}/print\")\n88: def print_prescription(\n89:     consultation_id: str,\n90:     lang: str = \"en\",\n91:     db: Session = Depends(get_db),\n92:     current_user: User = Depends(require_clinical_view())\n93: ):\n94:     tenant_id = current_user.tenant_id\n95:     consultation_repo = SQLAlchemyConsultationRepository(db)\n96:     patient_repo = SQLAlchemyPatientRepository(db)\n97:     \n98:     consultation = consultation_repo.find_by_id(consultation_id, tenant_id)\n99:     if not consultation:\n100:         raise HTTPException(status_code=status.HTTP_404_NOT_FOUND, detail=\"Consultation not found\")\n101:         \n102:     patient = patient_repo.find_by_id(consultation.patient_id, tenant_id)\n103:     if not patient:\n104:         raise HTTPException(status_code=status.HTTP_404_NOT_FOUND, detail=\"Patient not found\")\n105:         \n106:     doc_gen = PDFGeneratorAdapter()\n107:     try:\n108:         pdf_bytes = doc_gen.generate_prescription_pdf(consultation, patient, lang)\n109:         return Response(content=pdf_bytes, media_type=\"application/pdf\")\n110:     except Exception as e:\n111:         raise HTTPException(status_code=status.HTTP_400_BAD_REQUEST, detail=str(e))\n112: \nThe above content shows the entire, complete file contents of the requested file.\n"}
